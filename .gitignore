# Salida temporal del simulador
balance_tmp.md
_set_tmp.mjs
nul

# Sistema
Thumbs.db
.DS_Store
desktop.ini

# Dependencias de las herramientas de desarrollo (Playwright para los iconos)
node_modules/

# Editores
.vscode/
.idea/
*.swp

# Originales de las ilustraciones: pesan 29 MB y no hacen falta para jugar.
# Lo que se sirve es assets/dinos/, que sí va en el repositorio.
src/dinos/
__pycache__/

# Originales de las cartas enteras: mismo motivo que src/dinos/.
src/cartas/

# Originales de las piezas del tablero: 26 MB de PNG de los que se sirven los
# WebP de assets/piel/. Igual que src/dinos/ con las ilustraciones.
assets/piel/tablero_componentes/

# Originales de los marcos y chapas de carta: PNG de 26 MB; se sirven los WebP.
assets/marcos/*.png
assets/marcos/chapas/*.png

# Las seis tiras generadas por IA de las que sale terralis.woff2: 7 MB de PNG
# que sólo hacen falta para regenerar la fuente con tools/terralis.py.
assets/fuentes/terralis-*.png
tools/terralis-muestra.png

# Originales de los efectos del tablero: PNG de 1,2 MB cada uno; se sirven los
# WebP de assets/piel/efectos/, que salen de tools/efectos.py.
src/piel/

# Originales de los sonidos: WAV de 5,7 MB cada uno; se sirven los M4A de
# assets/sonidos/, que salen de tools/sonidos.py.
src/sonidos/
